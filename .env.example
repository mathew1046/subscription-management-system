# Local development defaults only. Never publish actual credentials.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://brightloop:local-development-only@127.0.0.1:5432/brightloop?sslmode=disable
APP_ORIGIN=http://localhost:3000
APP_CURRENCY=INR
BACKEND_URL=http://127.0.0.1:8080
HTTP_ADDR=127.0.0.1:8080
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=billing@brightloop.local
# Container routing differs from the native localhost SMTP settings above.
COMPOSE_SMTP_HOST=mailpit
COMPOSE_SMTP_PORT=1025
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_TELEMETRY_DISABLED=1
